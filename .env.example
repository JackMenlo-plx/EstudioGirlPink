# ===================================================================
# STUDIO GIRL PINK - ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.ENV.EXAMPLE)
# ===================================================================

# Entorno: development | production | test
NODE_ENV=development
ASPNETCORE_ENVIRONMENT=Development
PORT=5000

# Base de datos PostgreSQL
DATABASE_URL=Host=localhost;Port=5432;Database=studio_girl_pink;Username=postgres;Password=your_secure_password

# JWT y Seguridad de Sesión (Mínimo 32 caracteres)
JWT_SECRET=StudioGirlPink_Secret_ChangeInProduction_2026_AtLeast32Bytes!
JWT_EXPIRES_IN=8h

# URLs del Frontend y Orígenes Permitidos (CORS)
FRONTEND_URL=http://localhost:5000

# Administrador Inicial (Bootstrap)
STUDIO_GIRL_PINK_ADMIN_EMAIL=admin@studiogirlpink.com
STUDIO_GIRL_PINK_ADMIN_PASSWORD=StudioAdmin2026!#

# Proveedor de Correos (SMTP / Mailtrap / SendGrid / Resend)
# En development, si están vacías, se utiliza el DevConsoleEmailProvider
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM=no-reply@studiogirlpink.com
SMTP_FROM_NAME=Studio Girl Pink
