@model IReadOnlyList<StudioGirlPink.Models.Promotion>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Promociones";
}

<div class="studio-girl-pink-admin-page">
    <div class="admin-page-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div>
            <p class="studio-girl-pink-eyebrow">Campañas & Descuentos</p>
            <h1>Gestión de Promociones</h1>
            <p>Crea ofertas, descuentos por temporada y combos que aparecerán en la web pública para atraer más clientas.</p>
        </div>
        <div>
            <button type="button" class="studio-girl-pink-button studio-girl-pink-button-primary" onclick="toggleFormPromo()">
                + Nueva Promoción
            </button>
        </div>
    </div>

    <!-- FORMULARIO CREAR PROMOCIÓN -->
    <div id="formPromoCard" class="admin-card" style="display: none; margin-bottom: 2rem; background: #fff5f7; border: 1px solid #fecdd3;">
        <h2>🏷️ Crear Nueva Promoción</h2>
        <form asp-action="CrearPromocion" method="post" enctype="multipart/form-data" class="studio-girl-pink-finance-form">
            @Html.AntiForgeryToken()
            <div class="studio-girl-pink-form-row">
                <div class="studio-girl-pink-form-group">
                    <label>Título de la Promo *</label>
                    <input type="text" name="title" required class="studio-girl-pink-input" placeholder="Ej. Combo Amigas: 2x1 en Gelish" />
                </div>
                <div class="studio-girl-pink-form-group">
                    <label>Etiqueta / Badge</label>
                    <input type="text" name="badgeText" class="studio-girl-pink-input" placeholder="Ej. 20% OFF, 2x1, ESPECIAL DE MAYO" />
                </div>
                <div class="studio-girl-pink-form-group">
                    <label>Precio Especial (MXN, Opcional)</label>
                    <input type="number" step="0.5" min="0" name="discountPrice" class="studio-girl-pink-input" placeholder="Ej. 250.00" />
                </div>
                <div class="studio-girl-pink-form-group">
                    <label>Válida Hasta (Opcional)</label>
                    <input type="date" name="validUntil" class="studio-girl-pink-input" />
                </div>
                <div class="studio-girl-pink-form-group">
                    <label>Imagen / Flyer (Opcional)</label>
                    <input type="file" name="bannerPhoto" accept=".jpg,.jpeg,.png,.webp" class="studio-girl-pink-input-file" />
                </div>
                <div class="studio-girl-pink-form-group" style="flex: 2;">
                    <label>Descripción / Condiciones *</label>
                    <input type="text" name="description" required class="studio-girl-pink-input" placeholder="Ej. Válido de lunes a miércoles agendando con anticipo de $50 MXN." />
                </div>
                <div class="studio-girl-pink-form-group" style="align-self: flex-end;">
                    <button type="submit" class="studio-girl-pink-button studio-girl-pink-button-primary">
                        Publicar Promo
                    </button>
                </div>
            </div>
        </form>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
        @foreach (var p in Model)
        {
            <div class="admin-card" style="padding: 1.25rem; border: 1px solid @(p.IsActive ? "#f472b6" : "#cbd5e1"); position: relative;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
                    <span style="background: @(p.IsActive ? "#ec4899" : "#64748b"); color: #fff; padding: 2px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: bold;">
                        @(p.BadgeText ?? "PROMO")
                    </span>
                    <span class="status-badge status-@(p.IsActive ? "confirmada" : "rechazadanoasistio")">
                        @(p.IsActive ? "Activa" : "Pausada")
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(p.ImagePath))
                {
                    <div style="height: 140px; border-radius: 8px; overflow: hidden; margin-bottom: 0.75rem;">
                        <img src="@p.ImagePath" alt="@p.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                }

                <h3 style="margin: 0 0 0.35rem 0; color: #831843;">@p.Title</h3>
                <p style="font-size: 0.9rem; color: #475569; margin: 0 0 0.75rem 0;">@p.Description</p>

                @if (p.DiscountPrice.HasValue)
                {
                    <div style="font-size: 1.2rem; font-weight: bold; color: #be185d; margin-bottom: 0.5rem;">
                        $@p.DiscountPrice.Value.ToString("0.00") MXN
                    </div>
                }

                @if (p.ValidUntil.HasValue)
                {
                    <small style="display: block; color: #64748b; margin-bottom: 0.75rem;">
                        📅 Vence: @p.ValidUntil.Value.ToLocalTime().ToString("dd/MM/yyyy")
                    </small>
                }

                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 0.75rem; margin-top: 0.5rem;">
                    <!-- Pausar / Activar -->
                    <form asp-action="CambiarEstadoPromocion" asp-route-id="@p.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="studio-girl-pink-button studio-girl-pink-button-outline" style="padding: 2px 8px; font-size: 0.75rem;">
                            @(p.IsActive ? "Pausar" : "Reactivar")
                        </button>
                    </form>

                    <!-- Eliminar -->
                    <form asp-action="EliminarPromocion" asp-route-id="@p.Id" method="post" onsubmit="return confirm('¿Eliminar esta promoción?');" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="studio-girl-pink-button studio-girl-pink-button-outline" style="padding: 2px 8px; font-size: 0.75rem; color: #dc2626; border-color: #fca5a5;">
                            🗑️ Eliminar
                        </button>
                    </form>
                </div>
            </div>
        }
        </div>
    }
    else
    {
        <div class="admin-empty-state-box">
            <p>No tienes promociones registradas actualmente. Presiona <strong>"+ Nueva Promoción"</strong> para lanzar una oferta.</p>
        </div>
    }
</div>

<script>
    function toggleFormPromo() {
        const card = document.getElementById('formPromoCard');
        card.style.display = (card.style.display === 'none' || card.style.display === '') ? 'block' : 'none';
    }
</script>
