                </p>

                <!-- SWATCHES CLASIFICADOS -->
                <div class="studio-girl-pink-swatch-grid" style="grid-template-columns: repeat(4, 1fr); gap: 10px;">
                    <!-- Gama Rosas & Nudes -->
                    <button type="button" class="studio-girl-pink-swatch active" data-color="#d84988" data-name="Studio Glam Pink" style="background: #d84988;" title="Studio Glam Pink"></button>
