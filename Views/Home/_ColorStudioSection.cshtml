                <!-- SELECTOR DE TONO A MEDIDA -->
                <div style="margin-top: 1.25rem; background: #fdf2f8; padding: 0.85rem 1rem; border-radius: 12px; display: flex; align-items: center; justify-content: space-between; border: 1px solid #fce7f3;">
