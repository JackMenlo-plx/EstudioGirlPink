                        <path d="M 198 225 C 203 230 210 230 215 225" stroke="rgba(219, 39, 119, 0.25)" stroke-width="2" fill="none" stroke-linecap="round" />
                        <path d="M 248 240 C 252 245 258 245 262 240" stroke="rgba(219, 39, 119, 0.25)" stroke-width="2" fill="none" stroke-linecap="round" />

