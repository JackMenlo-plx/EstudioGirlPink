                <!-- 2. MODO FOTO SUBIDA POR LA CLIENTA CON CONTORNOS VECTORIALES ARRASTRABLES Y EDITABLES -->
                <div id="modoFotoUsuario" style="display: none; position: relative; width: 100%; height: 100%;">
