</section>

<!-- ESTILOS Y COMPORTAMIENTO TÉCNICO DE CONTORNOS EDITABLES -->
<style>
    .contorno-una-editable {
        position: absolute;
        width: 24px;
        height: 38px;
        border-radius: 50% 50% 45% 45% / 60% 60% 40% 40%;
        opacity: 0.92;
        cursor: grab;
        box-shadow: 0 3px 10px rgba(0,0,0,0.35), inset 0 2px 4px rgba(255,255,255,0.7);
        border: 1px solid rgba(255,255,255,0.45);
        transform: translate(-50%, -50%);
        transition: transform 0.1s, box-shadow 0.2s;
        overflow: hidden;
    }
    .contorno-una-editable:active {
        cursor: grabbing;
        transform: translate(-50%, -50%) scale(1.15);
        box-shadow: 0 6px 16px rgba(219, 39, 119, 0.45);
        z-index: 10;
    }
    .contorno-una-editable .brillo-gloss {
        position: absolute;
        top: 2px;
        left: 3px;
        width: 4px;
        height: 60%;
        background: rgba(255, 255, 255, 0.65);
        border-radius: 2px;
        filter: blur(0.5px);
    }

    /* Formas de uña aplicables dinámicamente */
    .forma-almendra {
        border-radius: 50% 50% 45% 45% / 65% 65% 35% 35% !important;
    }
    .forma-cuadrada {
        border-radius: 4px 4px 10px 10px !important;
    }
    .forma-coffin {
        border-radius: 3px 3px 12px 12px !important;
        clip-path: polygon(15% 0%, 85% 0%, 100% 100%, 0% 100%);
    }
    .forma-oval {
        border-radius: 50% 50% 45% 45% / 50% 50% 40% 40% !important;
    }
</style>

<script>
    function ajustarDimensionesUñas() {
        const alto = document.getElementById("sliderAltoUna").value + "px";
        const ancho = document.getElementById("sliderAnchoUna").value + "px";
        document.querySelectorAll(".contorno-una-editable").forEach(una => {
            una.style.height = alto;
            una.style.width = ancho;
        });
    }

    function cambiarFormaPunta(forma) {
        document.querySelectorAll(".contorno-una-editable").forEach(una => {
            una.classList.remove("forma-almendra", "forma-cuadrada", "forma-coffin", "forma-oval");
            una.classList.add("forma-" + forma);
        });
    }

    function restablecerPosiciones() {
        const posiciones = [
            { top: "28%", left: "32%" },
            { top: "20%", left: "45%" },
            { top: "24%", left: "58%" },
            { top: "36%", left: "70%" },
            { top: "55%", left: "22%" }
        ];
        document.querySelectorAll(".contorno-una-editable").forEach((una, i) => {
            if (posiciones[i]) {
                una.style.top = posiciones[i].top;
                una.style.left = posiciones[i].left;
            }
        });
        document.getElementById("sliderAltoUna").value = "38";
        document.getElementById("sliderAnchoUna").value = "22";
        ajustarDimensionesUñas();
        cambiarFormaPunta("almendra");
    }
</script>
