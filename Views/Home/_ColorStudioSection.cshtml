                    <button type="button" class="studio-girl-pink-swatch" data-color="#c8b6e2" data-name="Lilac Dream" style="background: #c8b6e2;" title="Lilac Dream"></button>
                    <button type="button" class="studio-girl-pink-swatch" data-color="#fbbf24" data-name="Gold Champagne" style="background: #fbbf24;" title="Gold Champagne"></button>

                    <!-- Gama Intensos & Elegantes -->
                    <button type="button" class="studio-girl-pink-swatch" data-color="#9d2860" data-name="Berry Velvet" style="background: #9d2860;" title="Berry Velvet"></button>
                    <button type="button" class="studio-girl-pink-swatch" data-color="#b91c1c" data-name="Rojo Pasión Carmín" style="background: #b91c1c;" title="Rojo Carmín"></button>
                    <button type="button" class="studio-girl-pink-swatch" data-color="#4c0519" data-name="Vino Tinto Imperial" style="background: #4c0519;" title="Vino Tinto"></button>
                    <button type="button" class="studio-girl-pink-swatch" data-color="#1e293b" data-name="Dark Onyx Gloss" style="background: #1e293b;" title="Dark Onyx"></button>
