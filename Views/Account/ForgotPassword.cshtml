@model StudioGirlPink.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<div class="studio-girl-pink-auth-container">
    <div class="studio-girl-pink-auth-card" style="max-width: 480px; margin: 2.5rem auto; text-align: center;">
        <div class="auth-icon" style="font-size: 2.8rem; margin-bottom: 0.5rem;">🌸</div>
        <p class="studio-girl-pink-eyebrow">Studio Girl Pink</p>
        <h1 style="font-size: 1.6rem; color: #831843; margin-bottom: 0.5rem;">Recuperar Contraseña</h1>
        <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.5rem; line-height: 1.5;">
            Ingresa el correo electrónico asociado a tu cuenta de <strong>Clienta (Fidelización)</strong> o <strong>Administrador</strong> y te enviaremos un enlace de recuperación seguro con vigencia de 20 minutos.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="studio-girl-pink-alert studio-girl-pink-alert-danger" style="text-align: left; margin-bottom: 1rem;">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="ForgotPassword" method="post" class="studio-girl-pink-auth-form" style="text-align: left;">
            @Html.AntiForgeryToken()

            <div class="studio-girl-pink-form-group">
                <label asp-for="Email">Correo Electrónico Registrado</label>
                <input asp-for="Email" type="email" class="studio-girl-pink-input" placeholder="tu@correo.com" required autofocus />
                <span asp-validation-for="Email" class="studio-girl-pink-error"></span>
            </div>

            <button type="submit" class="studio-girl-pink-button studio-girl-pink-button-primary studio-girl-pink-button-block" style="margin-top: 1.25rem;">
                ✉️ Enviar Enlace de Recuperación
            </button>
        </form>

        <div class="auth-card-footer" style="margin-top: 1.5rem; border-top: 1px solid #fce7f3; padding-top: 1rem;">
            <p style="margin-bottom: 0.5rem;">
                <a asp-action="Login" style="font-size: 0.9rem; color: #db2777; font-weight: 500; text-decoration: none;">
                    ← Volver a Iniciar Sesión (Clientas)
                </a>
            </p>
            <p style="margin: 0;">
                <a asp-action="AdminLogin" style="font-size: 0.8rem; color: #94a3b8; text-decoration: none;">
                    Acceso Administrativo
                </a>
            </p>
        </div>
    </div>
</div>
