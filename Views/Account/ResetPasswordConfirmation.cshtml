@{
    ViewData["Title"] = "Contraseña Actualizada";
}

<div class="studio-girl-pink-auth-container">
    <div class="studio-girl-pink-auth-card" style="max-width: 480px; margin: 2.5rem auto; text-align: center;">
        <div class="auth-icon" style="font-size: 3rem; margin-bottom: 0.5rem;">🎉</div>
        <p class="studio-girl-pink-eyebrow">Studio Girl Pink</p>
        <h1 style="font-size: 1.6rem; color: #831843; margin-bottom: 0.5rem;">¡Contraseña Restablecida!</h1>
        
        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; text-align: left;">
            <p style="color: #166534; font-weight: 600; margin-bottom: 0.5rem; font-size: 0.95rem;">
                ✓ Tu cuenta está protegida
            </p>
            <p style="color: #15803d; font-size: 0.9rem; line-height: 1.5; margin: 0;">
                Tu contraseña ha sido actualizada con éxito y todas las sesiones activas previas han sido cerradas por seguridad. Ya puedes iniciar sesión con tu nueva contraseña.
            </p>
        </div>

        <a asp-action="Login" class="studio-girl-pink-button studio-girl-pink-button-primary studio-girl-pink-button-block" style="text-decoration: none; display: block;">
            Iniciar Sesión con tu Nueva Contraseña
        </a>

        <div style="margin-top: 1.25rem;">
            <a href="/" style="font-size: 0.85rem; color: #64748b; text-decoration: none;">
                ← Ir al Inicio de Studio Girl Pink
            </a>
        </div>
    </div>
</div>
