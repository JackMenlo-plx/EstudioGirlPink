@model StudioGirlPink.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="studio-girl-pink-auth-container">
    <div class="studio-girl-pink-auth-card" style="max-width: 480px; margin: 2.5rem auto; text-align: center;">
        <div class="auth-icon" style="font-size: 2.8rem; margin-bottom: 0.5rem;">🔑</div>
        <p class="studio-girl-pink-eyebrow">Studio Girl Pink</p>
        <h1 style="font-size: 1.6rem; color: #831843; margin-bottom: 0.5rem;">Nueva Contraseña</h1>
        <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.5rem;">
            Ingresa y confirma tu nueva contraseña para la cuenta: <strong>@Model.Email</strong>
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="studio-girl-pink-alert studio-girl-pink-alert-danger" style="text-align: left; margin-bottom: 1.25rem;">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="ResetPassword" method="post" class="studio-girl-pink-auth-form" style="text-align: left;">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="studio-girl-pink-form-group">
                <label asp-for="Password">Nueva Contraseña *</label>
                <input asp-for="Password" type="password" class="studio-girl-pink-input" placeholder="Mínimo 12 caracteres seguros" required autofocus />
                <span asp-validation-for="Password" class="studio-girl-pink-error"></span>
                <small style="color: #94a3b8; font-size: 0.78rem; display: block; margin-top: 4px;">
                    Debe incluir al menos 12 caracteres, mayúsculas, minúsculas, números y un símbolo.
                </small>
            </div>

            <div class="studio-girl-pink-form-group">
                <label asp-for="ConfirmPassword">Confirmar Nueva Contraseña *</label>
                <input asp-for="ConfirmPassword" type="password" class="studio-girl-pink-input" placeholder="Repite tu nueva contraseña" required />
                <span asp-validation-for="ConfirmPassword" class="studio-girl-pink-error"></span>
            </div>

            <button type="submit" class="studio-girl-pink-button studio-girl-pink-button-primary studio-girl-pink-button-block" style="margin-top: 1.25rem;">
                💾 Guardar Nueva Contraseña
            </button>
        </form>

        <div class="auth-card-footer" style="margin-top: 1.5rem;">
            <p>
                <a asp-action="Login" style="font-size: 0.85rem; color: #64748b; text-decoration: none;">
                    ← Cancelar y volver al Login
                </a>
            </p>
        </div>
    </div>
</div>
