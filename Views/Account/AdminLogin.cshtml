<script>
    async function iniciarAccesoHuellaReal() {
        const statusMsg = document.getElementById('bioStatusMsg');
        const icon = document.getElementById('fingerprintIcon');
        const btn = document.getElementById('btnBiometrico');

        statusMsg.style.display = 'block';
        statusMsg.style.color = '#db2777';
        statusMsg.innerHTML = '⏳ <strong>Activando sensor biométrico...</strong> Coloca tu huella o confirma tu clave en la ventana de Windows Hello.';
        btn.disabled = true;
        icon.style.transform = 'scale(1.2)';

        if (!window.PublicKeyCredential) {
            statusMsg.style.color = '#dc2626';
            statusMsg.textContent = 'Tu navegador no soporta autenticación biométrica WebAuthn. Ingresa con tu contraseña.';
            btn.disabled = false;
            icon.style.transform = 'scale(1)';
            return;
        }

        try {
            const challenge = new Uint8Array(32);
            window.crypto.getRandomValues(challenge);

            let credential;
            const storedId = localStorage.getItem("studio_pink_admin_cred_id");
            
            if (!storedId) {
                const userHandle = new Uint8Array(16);
                window.crypto.getRandomValues(userHandle);

                credential = await navigator.credentials.create({
                    publicKey: {
                        challenge: challenge,
                        rp: { name: "Studio Girl Pink Admin" },
                        user: {
                            id: userHandle,
                            name: "admin@studiogirlpink.com",
                            displayName: "Administradora Studio Girl Pink"
                        },
                        pubKeyCredParams: [
                            { type: "public-key", alg: -7 },   // ES256
                            { type: "public-key", alg: -257 }  // RS256
                        ],
                        authenticatorSelection: {
                            authenticatorAttachment: "platform",
                            userVerification: "required"
                        },
                        timeout: 60000
                    }
                });

                if (credential && credential.id) {
                    localStorage.setItem("studio_pink_admin_cred_id", credential.id);
                }
            } else {
                credential = await navigator.credentials.get({
                    publicKey: {
                        challenge: challenge,
                        userVerification: "required",
                        timeout: 60000
                    }
                });
            }

            if (!credential) {
                throw new Error("No se obtuvo verificación biométrica.");
            }

            icon.style.transform = 'scale(1)';
            statusMsg.style.color = '#16a34a';
            statusMsg.innerHTML = '✓ <strong>¡Huella verificada correctamente!</strong> Accediendo...';

            const token = document.querySelector('#antiForgeryFormBio input[name="__RequestVerificationToken"]').value;

            // Preparar metadatos devueltos por el hardware para envío seguro
            const rawIdBase64 = btoa(String.fromCharCode(...new Uint8Array(credential.rawId)));
            const clientDataBase64 = btoa(String.fromCharCode(...new Uint8Array(credential.response.clientDataJSON)));

            const response = await fetch('/admin/login-biometrico', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    credentialId: credential.id,
                    rawId: rawIdBase64,
                    clientDataJSON: clientDataBase64
                })
            });

            const data = await response.json();
            if (data.success) {
                window.location.href = data.redirectUrl || '/admin';
            } else {
                statusMsg.style.color = '#dc2626';
                statusMsg.textContent = data.message || 'Error de sesión biométrica.';
                btn.disabled = false;
            }

        } catch (err) {
            console.warn("Autenticación biométrica no completada:", err);
            icon.style.transform = 'scale(1)';
            btn.disabled = false;
            statusMsg.style.color = '#b91c1c';
            statusMsg.innerHTML = '✕ <strong>Verificación biométrica cancelada o denegada.</strong> No se concedió acceso. Si lo prefieres, ingresa abajo con tu contraseña.';
        }
    }
</script>