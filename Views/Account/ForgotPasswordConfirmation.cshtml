@{
    ViewData["Title"] = "Solicitud Enviada - Recuperar Contraseña";
}

<div class="studio-girl-pink-auth-container">
    <div class="studio-girl-pink-auth-card" style="max-width: 480px; margin: 2.5rem auto; text-align: center;">
        <div class="auth-icon" style="font-size: 3rem; margin-bottom: 0.5rem;">💌</div>
        <p class="studio-girl-pink-eyebrow">Studio Girl Pink</p>
        <h1 style="font-size: 1.6rem; color: #831843; margin-bottom: 0.75rem;">Revisa tu Correo</h1>
        
        <div style="background: #fdf2f8; border: 1px solid #fbcfe8; border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; text-align: left;">
            <p style="color: #831843; font-weight: 600; margin-bottom: 0.5rem; font-size: 0.95rem;">
                🌸 Enlace de restablecimiento enviado
            </p>
            <p style="color: #64748b; font-size: 0.9rem; line-height: 1.5; margin: 0;">
                Si el correo está registrado en nuestro sistema, recibirás un mensaje con un enlace seguro. Por tu seguridad, este enlace tiene una vigencia de <strong>20 minutos</strong>.
            </p>
        </div>

        <p style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 1.5rem;">
            ¿No lo encuentras? Recuerda revisar también tu carpeta de <em>Spam</em> o <em>Correo no deseado</em>.
        </p>

        <a asp-action="Login" class="studio-girl-pink-button studio-girl-pink-button-primary studio-girl-pink-button-block" style="text-decoration: none; display: block;">
            Volver a Iniciar Sesión
        </a>

        <div style="margin-top: 1rem;">
            <a href="/" style="font-size: 0.85rem; color: #64748b; text-decoration: none;">
                ← Ir a la Página Principal
            </a>
        </div>
    </div>
</div>
